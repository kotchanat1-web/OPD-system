@echo off
title OPD System Starter - คลินิกเวชกรรมนครสวรรค์เฮลท์แคร์
chcp 65001 >nul
cls
echo ===================================================================
echo     เริ่มต้นระบบคลินิกเวชกรรมนครสวรรค์เฮลท์แคร์ + เครื่องอ่านบัตร
echo ===================================================================
echo.

:: Check if port 8181 is already running
netstat -ano | findstr 8181 | findstr LISTENING >nul 2>&1
if %errorlevel% neq 0 (
    echo [1/2] กำลังเริ่มบริการเครื่องอ่านบัตรประชาชน (Smart Card Bridge พอร์ต 8181)...
    start "Smart Card Bridge" /min "%~dp0start-card-reader.bat"
    timeout /t 2 >nul
) else (
    echo [1/2] บริการเครื่องอ่านบัตรประชาชน (พอร์ต 8181) กำลังทำงานอยู่แล้ว
)

echo [2/2] กำลังเปิดระบบเวชระเบียน OPD ในเบราว์เซอร์ (http://127.0.0.1:8181/app)...
start "" "http://127.0.0.1:8181/app"

echo.
echo ===================================================================
echo  [SUCCESS] ระบบคลินิกเวชระเบียนพร้อมใช้งานเรียบร้อยแล้ว!
echo ===================================================================
timeout /t 3 >nul
exit
